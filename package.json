{
  "name": "vienna-transport-ha",
  "private": true,
  "version": "1.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "test": "vitest --run",
    "build": "tsc --noEmit && vite build",
    "build:release": "tsc --noEmit && vite build --outDir custom_components/vienna_transport/frontend",
    "preview": "vite preview",
    "format": "prettier --write \"**/*.{ts,js,json,css,html}\"",
    "format:check": "prettier --check \"**/*.{ts,js,json,css,html}\""
  },
  "dependencies": {
    "lit": "^3.3.3"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "prettier": "^3.10.1",
    "typescript": "~5.9.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
